# ============================================================================
# ExplainIndia 45s — Indian Viral Topic Explainer Studio
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
# ============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5180
STORAGE_DIR=./storage
FFMPEG_BIN=
FFPROBE_BIN=

# --- PostgreSQL Database (Docker Compose Default) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hinditrend
POSTGRES_PASSWORD=hinditrend_dev_pass
POSTGRES_DB=hindi_trend_ai
DATABASE_URL=postgresql://hinditrend:hinditrend_dev_pass@localhost:5432/hindi_trend_ai

# --- Google Gemini & Vertex AI (Required for live AI generation & Veo 3.1) ---
# Get your key from Google Cloud Console or Google AI Studio
GEMINI_API_KEY=YOUR_GOOGLE_CLOUD_GEMINI_API_KEY_HERE
GEMINI_MODEL=auto
VERTEX_PROJECT_ID=
DAILY_GEMINI_LIMIT=100

# --- n8n Self-Hosted Automation (Docker Compose Default) ---
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=

# --- Topic Discovery & News RSS ---
# Public Indian RSS feeds work out-of-the-box for free. Optional NewsData.io / GNews API key:
NEWS_API_KEY=

# --- Neural Voiceover (Roman Hinglish + English) ---
# Options: edge_free (default free hi-IN-SwaraNeural / hi-IN-MadhurNeural voice) | google_cloud | sarvam | elevenlabs
TTS_PROVIDER=edge_free
TTS_VOICE_HINDI=hi-IN-SwaraNeural
GOOGLE_TTS_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
AVATAR_PROVIDER=local_expression_animator
AVATAR_API_KEY=

# --- Publishing: YouTube Data API v3 ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/publish/youtube/callback
YOUTUBE_REFRESH_TOKEN=

# --- Publishing: Instagram Graph API ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
